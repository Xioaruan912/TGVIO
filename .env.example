# TGVIO runtime
TGVIO_ENV=development
TGVIO_RUN_BOT=false
TGVIO_PUBLISH_ENABLED=false
TGVIO_LIVE_FIXTURE_ENABLED=false
TGVIO_LIVE_FIXTURE_MAX_MB=100
TGVIO_WORKER_CONCURRENCY=2
TGVIO_TELEGRAM_DOWNLOAD_WORKERS=8
TGVIO_TELEGRAM_UPLOAD_WORKERS=16
TGVIO_TELEGRAM_UPLOAD_GLOBAL_WORKERS=16
TGVIO_TELEGRAM_PART_SIZE_KB=512
TGVIO_TELEGRAM_SHARD_RETRIES=3
TGVIO_BATCH_WINDOW_MS=1500
TGVIO_BATCH_MAX_WAIT_MS=5000
TGVIO_BATCH_MAX_ITEMS=100
TGVIO_COLLECTIONS_ENABLED=true
TGVIO_SPOILER_CONFIRM_TIMEOUT_SECONDS=60
TGVIO_DISK_RESERVE_MB=5120
TGVIO_UPLOAD_PART_MB=1900
TGVIO_CACHE_RETENTION_HOURS=24
TGVIO_CACHE_CLEANUP_INTERVAL_MINUTES=30
TGVIO_AUTO_RETRY_ENABLED=true
TGVIO_AUTO_RETRY_MAX_ATTEMPTS=3
TGVIO_AUTO_RETRY_BASE_SECONDS=15
TGVIO_AUTO_RETRY_MAX_SECONDS=300
TGVIO_AUTO_RETRY_POLL_SECONDS=2
TGVIO_URL_ENABLED=false
TGVIO_URL_PRIVATE_NETWORK_POLICY=block
# Optional deployment-only static proxy. Changes require restart; diagnostics never echo this value.
TGVIO_STATIC_PROXY_URL=
TGVIO_STATIC_PROXY_PROBE_TIMEOUT_SECONDS=2
TGVIO_ARCHIVE_ENABLED=false
TGVIO_ARCHIVE_WEBDAV_URL=
TGVIO_ARCHIVE_REMOTE_ROOT=TGVIO
TGVIO_ARCHIVE_WEBDAV_USER=
TGVIO_ARCHIVE_WEBDAV_PASSWORD=
TGVIO_ARCHIVE_PROFILE_ID=primary
TGVIO_ARCHIVE_POLICY=required
TGVIO_ARCHIVE_POLL_SECONDS=10
TGVIO_DATA_DIR=/app/data
TGVIO_DOWNLOAD_DIR=/app/downloads
TGVIO_LOG_LEVEL=INFO
TGVIO_LOG_DIR=/app/logs
TGVIO_LOG_FILE_ENABLED=true
TGVIO_LOG_MAX_MB=20
TGVIO_LOG_BACKUP_COUNT=5

# Telegram credentials belong only in the untracked deployment .env
API_ID=
API_HASH=
BOT_TOKEN=
DEST_CHANNEL=
ALLOWED_USERS=
CHANNEL_AT=
GROUP_AT=
COVER_MODE=true
COVER_WIDTH=1280
FORWARD_CAPTION=false

# Read-only private operations dashboard. Loopback only; disabled by default.
# TGVIO_DASHBOARD_TOKEN must be a high-entropy value of at least 32 characters.
TGVIO_DASHBOARD_ENABLED=false
TGVIO_DASHBOARD_HOST=127.0.0.1
TGVIO_DASHBOARD_PORT=8787
TGVIO_DASHBOARD_TOKEN=

# Redacted HTTPS webhook notification outbox. Disabled by default; HTTPS only.
TGVIO_WEBHOOK_ENABLED=false
TGVIO_WEBHOOK_URL=
TGVIO_WEBHOOK_TOKEN=
TGVIO_WEBHOOK_TIMEOUT_SECONDS=10
TGVIO_WEBHOOK_MAX_ATTEMPTS=5
TGVIO_NOTIFICATION_POLL_SECONDS=15

# Owner alerts: only failures/anomalies (and their recovery) are pushed to the
# owner's private Telegram chat. Empty TGVIO_ALERT_USER_ID uses the first
# ALLOWED_USERS entry.
TGVIO_ALERTS_ENABLED=true
TGVIO_ALERT_USER_ID=
TGVIO_ALERT_COOLDOWN_SECONDS=3600
TGVIO_ALERT_POLL_SECONDS=60

# Show a preview card (confirm / mode / abandon) before a collection publishes.
TGVIO_COLLECTION_PREVIEW_ENABLED=true

# Deployment metadata. Do not put private key contents in this file.
VPS_HOST=199.47.242.40
VPS_PORT=22
VPS_USER=root
VPS_SSH_KEY=/root/.ssh/tgvio_hostdzire_ed25519
VPS_APP_DIR=/root/TGVIO

# GitHub authentication is supplied interactively or by a dedicated credential
# manager. Never put a password or personal access token in this file.
GITHUB_REPO=
GITHUB_BRANCH=main
