# ============================================================
# TGVIO 配置文件示例
# 说明：这是示例文件。请勿直接使用；运行 install.sh 会自动生成 .env，
#       也可以通过脚本菜单「7) 修改配置」以交互方式修改。
# 注意：本文件不要填写真实密钥，也不要提交到公开仓库。
# ============================================================

# ---------- Telegram 必填信息（install.sh 会引导填写）----------
# 在 my.telegram.org 创建应用后获得
API_ID=
API_HASH=
# 在 Telegram 的 @BotFather 创建机器人后获得，形如 123456:ABC...
BOT_TOKEN=
# 目标频道：@频道名 或 -100 开头的数字 ID
DEST_CHANNEL=
# 允许使用机器人的用户数字 ID，多个用英文逗号分隔（可在 @userinfobot 获取）
ALLOWED_USERS=

# ---------- 运行模式 ----------
# development / production
TGVIO_ENV=production
# 是否真正启动机器人（install.sh 会自动设为 true）
TGVIO_RUN_BOT=false
# 是否允许自动发布到频道（install.sh 会自动设为 true）
TGVIO_PUBLISH_ENABLED=false
# 受控测试发布功能，普通用户保持 false
TGVIO_LIVE_FIXTURE_ENABLED=false
TGVIO_LIVE_FIXTURE_MAX_MB=100

# ---------- 发布外观 ----------
# 封面模式：true 时频道只发封面，媒体进入评论区
COVER_MODE=true
COVER_WIDTH=1280
# 是否保留原消息里的文字
FORWARD_CAPTION=false
# 频道与讨论组的展示名（可选，用于文案尾部）
CHANNEL_AT=
GROUP_AT=
# 合集 / 相册相关
TGVIO_COLLECTIONS_ENABLED=true
TGVIO_SPOILER_CONFIRM_TIMEOUT_SECONDS=60

# ---------- 合集预览与整理 ----------
TGVIO_COLLECTION_PREVIEW_ENABLED=true
TGVIO_COLLECTION_EDITING_ENABLED=true
# 效果预览：最多下载一份封面来源（字节 / 秒）
TGVIO_PREVIEW_ENABLED=true
TGVIO_PREVIEW_MAX_SOURCE_BYTES=33554432
TGVIO_PREVIEW_TIMEOUT_SECONDS=30

# ---------- 下载与上传性能 ----------
TGVIO_WORKER_CONCURRENCY=2
TGVIO_TELEGRAM_DOWNLOAD_WORKERS=8
TGVIO_TELEGRAM_UPLOAD_WORKERS=16
TGVIO_TELEGRAM_UPLOAD_GLOBAL_WORKERS=16
TGVIO_TELEGRAM_PART_SIZE_KB=512
TGVIO_TELEGRAM_SHARD_RETRIES=3
TGVIO_BATCH_WINDOW_MS=1500
TGVIO_BATCH_MAX_WAIT_MS=5000
TGVIO_BATCH_MAX_ITEMS=100
TGVIO_UPLOAD_PART_MB=1900

# ---------- 磁盘与缓存 ----------
TGVIO_DISK_RESERVE_MB=5120
TGVIO_CACHE_RETENTION_HOURS=24
TGVIO_CACHE_CLEANUP_INTERVAL_MINUTES=30

# ---------- 自动重试 ----------
TGVIO_AUTO_RETRY_ENABLED=true
TGVIO_AUTO_RETRY_MAX_ATTEMPTS=3
TGVIO_AUTO_RETRY_BASE_SECONDS=15
TGVIO_AUTO_RETRY_MAX_SECONDS=300
TGVIO_AUTO_RETRY_POLL_SECONDS=2

# ---------- 链接下载 ----------
TGVIO_URL_ENABLED=false
# 私网访问策略：allow / warn / block
TGVIO_URL_PRIVATE_NETWORK_POLICY=block
# 可选：yt-dlp 登录态 Cookie 文件路径（容器内绝对路径，例如 /app/session/cookies.txt）
# 需要下载会员/年龄限制内容时配置；不配置则留空。画质与“仅音频”在机器人内设置。
TGVIO_YTDLP_COOKIES_FILE=

# ---------- 来源读取器（个人账号 session，可选）----------
# 全部可在 Bot 内完成：/source → 登录 → 添加来源；用 /pick 选择要发布的内容。
# session 文件存在即自动启用；也可在容器内运行 scripts/login_source_session.py 登录。
TGVIO_SOURCE_SESSION=/app/session/source_user
# 默认白名单（也可在 Bot 内添加/删除，Bot 内设置优先级更高），逗号分隔：@频道名,-1001234567890
TGVIO_SOURCE_CHATS=
# 个人账号下载并发（个人号风控更敏感，建议 2-6）
TGVIO_SOURCE_DOWNLOAD_WORKERS=4
# 合并发布（/pick 多选）一次最多提交多少项；超出会提示分批。默认 100，可调大。
TGVIO_MERGE_MAX_ITEMS=100

# ---------- 网络代理（可选，部署环境使用；改动需重启）----------
TGVIO_STATIC_PROXY_URL=
TGVIO_STATIC_PROXY_PROBE_TIMEOUT_SECONDS=2

# ---------- WebDAV 归档（可选）----------
TGVIO_ARCHIVE_ENABLED=false
TGVIO_ARCHIVE_WEBDAV_URL=
TGVIO_ARCHIVE_REMOTE_ROOT=TGVIO
TGVIO_ARCHIVE_WEBDAV_USER=
TGVIO_ARCHIVE_WEBDAV_PASSWORD=
TGVIO_ARCHIVE_PROFILE_ID=primary
# required / best_effort
TGVIO_ARCHIVE_POLICY=required
TGVIO_ARCHIVE_POLL_SECONDS=10
TGVIO_ARCHIVE_RESPONSE_TIMEOUT_SECONDS=3600
TGVIO_ARCHIVE_VERIFY_ATTEMPTS=120
TGVIO_ARCHIVE_VERIFY_INTERVAL_SECONDS=20
# v2 = 简短日期目录；v1 = 旧目录结构
TGVIO_ARCHIVE_LAYOUT=v2

# ---------- 数据与日志位置（容器内路径，一般不用改）----------
TGVIO_DATA_DIR=/app/data
TGVIO_DOWNLOAD_DIR=/app/downloads
TGVIO_LOG_LEVEL=INFO
TGVIO_LOG_DIR=/app/logs
TGVIO_LOG_FILE_ENABLED=true
TGVIO_LOG_MAX_MB=20
TGVIO_LOG_BACKUP_COUNT=5

# ---------- 只读管理页面（可选，默认关闭）----------
TGVIO_DASHBOARD_ENABLED=false
TGVIO_DASHBOARD_HOST=127.0.0.1
TGVIO_DASHBOARD_PORT=8787
TGVIO_DASHBOARD_TOKEN=

# ---------- 通知 Webhook（可选，默认关闭）----------
TGVIO_WEBHOOK_ENABLED=false
TGVIO_WEBHOOK_URL=
TGVIO_WEBHOOK_TOKEN=
TGVIO_WEBHOOK_TIMEOUT_SECONDS=10
TGVIO_WEBHOOK_MAX_ATTEMPTS=5
TGVIO_NOTIFICATION_POLL_SECONDS=15

# ---------- 失败提醒 ----------
TGVIO_ALERTS_ENABLED=true
TGVIO_ALERT_USER_ID=
TGVIO_ALERT_COOLDOWN_SECONDS=3600
TGVIO_ALERT_POLL_SECONDS=60
