# 在 my.telegram.org 获取
API_ID=
API_HASH=

# @BotFather 创建机器人获取
BOT_TOKEN=

# 目标频道，形如 @channel 或 -100xxxxxxxxxx
DEST_CHANNEL=

# 允许使用的用户 ID（个人账号，逗号分隔），在 @userinfobot 查询
ALLOWED_USERS=

# 发布内容 caption 末尾自动附加的 @提及（引流水印）。留空不附加
# CHANNEL_AT=@channel          # 不填时自动取 DEST_CHANNEL（需以 @ 开头）
# GROUP_AT=@group             # 讨论组群名 @

# 可选配置
# 以上 API_ID/API_HASH/BOT_TOKEN/DEST_CHANNEL/ALLOWED_USERS 为启动必填项；
# 缺失或数值范围非法时进程会 fail-fast，日志只报告变量名，不回显值。
# 本节静态环境变量修改后需重启容器；WebDAV/代理/用户偏好/目的地与自动来源
# 继续由 Bot UI 动态管理，其中 profile 修改只影响之后接受的新任务。
# MAX_FILE_SIZE=2097152000
# DOWNLOAD_DIR=/app/downloads
# 并行下载数（默认 3）
# DOWNLOAD_CONCURRENCY=3
# 单个任务下载超时秒数（默认 1200）
# DOWNLOAD_TIMEOUT=1200
# 下载超时/网络失败自动重试次数（默认 2，0=关闭）
# DOWNLOAD_AUTO_RETRY=2
# 并发下载分片数（默认 8）
# DOWNLOAD_WORKERS=8
# 并发上传分片数（默认 16）
# UPLOAD_WORKERS=16
# 传输分片大小 KB（默认 512）
# PART_SIZE_KB=512
# 18+ 确认弹窗超时秒数（默认 60，超时自动按"正常"处理）
# CONFIRM_TIMEOUT=60
# 合集聚合等待秒数（默认 10）：同一用户短时间连续到达的多个相册（Telegram 会拆分 >10 个）合并为一个合集任务，只发一个封面
# COLLECTION_GATHER_SECONDS=10
# 单任务上传超时秒数（默认 1800）
# UPLOAD_TIMEOUT=1800
# 是否转发原消息文字（caption）。false=纯视频/图片转发（默认）
# FORWARD_CAPTION=false
# 进度条编辑全局最小间隔秒数（默认 2.0，防 Telegram 限流）
# PROGRESS_MIN_INTERVAL=2.0
# 命令回复/提示类消息自动撤回秒数（默认 10；0=关闭）
# AUTO_DELETE_SECONDS=10
# 封面模式（默认 false）：频道只发封面图，视频进频道关联讨论组的评论区
# 需先在 Telegram 手动完成：1.新建群组 2.频道设置→讨论→关联该群组 3.把机器人加入群组并设为管理员
# COVER_MODE=false
# 封面图最大宽/高像素（默认 1280）
# COVER_WIDTH=1280
# 封面相册最多图片数（默认 10，超出丢弃）
# MAX_COVER_IMAGES=10
# 合集会话（默认 true）：转发自动开始合集，多次转发汇总为一个合集（视频进同一评论区）
# SESSION_COLLECT=true
# 合集「结束并发布」按钮显示秒数（默认 5，超时隐藏按钮、继续等待转发）
# SESSION_END_TIMEOUT=5
# F3 磁盘策略（先保持监控模式；确认生产阈值后再启用强制）
# DISK_ENFORCE=false
# MIN_FREE_BYTES=5368709120
# MIN_FREE_PERCENT=10
# MAX_CACHE_BYTES=0
# CACHE_RETENTION_HOURS=72
# FAILED_CACHE_RETENTION_HOURS=168
# HISTORY_RETENTION_DAYS=30   # 终态任务元数据/caption 默认保留 30 天
# EVENT_RETENTION_DAYS=30     # 任务事件保留 30-90 天
# DISK_CHECK_INTERVAL=60
# UNKNOWN_JOB_RESERVE_BYTES=2147483648
# Docker liveness 只使用本地 heartbeat/SQLite/灾难性磁盘阈值，不探测 Telegram/WebDAV
# HEALTH_HEARTBEAT_MAX_AGE=45
# HEALTH_MIN_FREE_BYTES=268435456
# M1 媒体兼容性/预览（默认只分析，不修改文件）
# MEDIA_COMPAT_MODE=analyze     # off|analyze|remux
# FASTSTART_MAX_BYTES=0         # 0=只受磁盘预检约束
# TRANSCODE_ENABLED=false       # M1 不自动有损转码
# THUMBNAIL_POSITION=auto       # auto|seconds（后续 M1 缩略图候选）
# URL_PRIVATE_NETWORK_POLICY=warn  # allow|warn|block；公开多用户部署建议 block
# WebDAV 备份配置运行中用 /webdav 命令设置（持久化到 session/webdav.json），无需写入 .env
# 命令示例：/webdav on | /webdav url https://xxx/dav/ | /webdav user xxx | /webdav pass xxx | /webdav path /115/Pron
