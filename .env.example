# 在 my.telegram.org 获取
API_ID=
API_HASH=

# @BotFather 创建机器人获取
BOT_TOKEN=

# 目标频道，形如 @channel 或 -100xxxxxxxxxx
DEST_CHANNEL=

# 允许使用的用户 ID（个人账号，逗号分隔），在 @userinfobot 查询
ALLOWED_USERS=

# 可选配置
# MAX_FILE_SIZE=2097152000
# DOWNLOAD_DIR=/app/downloads
# 并行下载数（默认 3）
# DOWNLOAD_CONCURRENCY=3
# 单个任务下载超时秒数（默认 1200）
# DOWNLOAD_TIMEOUT=1200
# 18+ 确认弹窗超时秒数（默认 60，超时自动取消）
# CONFIRM_TIMEOUT=60
# 相册聚合等待秒数（默认 1.0）
# ALBUM_GATHER_SECONDS=1.0
# 单任务上传超时秒数（默认 1800）
# UPLOAD_TIMEOUT=1800
# 是否转发原消息文字（caption）。false=纯视频/图片转发（默认）
# FORWARD_CAPTION=false
# 进度条编辑全局最小间隔秒数（默认 2.0，防 Telegram 限流）
# PROGRESS_MIN_INTERVAL=2.0
# 未设置 18+ 模式时暂存视频的等待秒数（默认 300，超时按"正常"处理）
# HELD_TIMEOUT=300
# 命令回复/提示类消息自动撤回秒数（默认 10；0=关闭）
# AUTO_DELETE_SECONDS=10
