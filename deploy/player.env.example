# Player-only compose input. Copy outside the repository with mode 0600.
# It is never read by docker-compose.yml and must not contain Bot variables.
TGVIO_PLAYER_IMAGE=tgvio-player:replace-before-deploy
TGVIO_PLAYER_ENABLED=false
TGVIO_PLAYER_HOST=0.0.0.0
TGVIO_PLAYER_PORT=8790
TGVIO_PLAYER_HOST_DATA_DIR=/var/lib/tgvio-player

# Generate a 32+ character secret independently for Player. A single-owner
# deployment may instead use an exact 9-digit numeric PIN. Do not reuse
# BOT_TOKEN, API_HASH, a Telegram session, or the Bot Archive write credential.
TGVIO_PLAYER_ACCESS_SECRET=
TGVIO_PLAYER_WEBDAV_URL=
TGVIO_PLAYER_WEBDAV_USER=
TGVIO_PLAYER_WEBDAV_PASSWORD=
TGVIO_PLAYER_REMOTE_ROOT=TGVIO
TGVIO_PLAYER_DELETE_ENABLED=false

TGVIO_PLAYER_CATALOG_POLL_SECONDS=60
TGVIO_PLAYER_MAX_STREAMS=8
TGVIO_PLAYER_MAX_STREAMS_PER_CLIENT=4
# Clips longer than this many seconds are treated as large videos.
TGVIO_PLAYER_LARGE_VIDEO_SECONDS=300
# Build virtual faststart overlays for existing clips in the background.
TGVIO_PLAYER_FASTSTART_BACKFILL=true
# On-disk byte-range cache for smooth seeking /播放边缓存 (bytes, chunk size).
TGVIO_PLAYER_CACHE_BYTES=17179869184
TGVIO_PLAYER_CACHE_CHUNK_MB=4
# Upstream read window and concurrent window fetches (115/OpenList throttles >4).
TGVIO_PLAYER_CACHE_WINDOW_MB=32
TGVIO_PLAYER_CACHE_CONCURRENCY=4
# Pre-cache the head of every video (16 MB each; ~10 GB for the whole catalog).
TGVIO_PLAYER_WARM_ALL=true
TGVIO_PLAYER_WARM_HEAD_MB=16
